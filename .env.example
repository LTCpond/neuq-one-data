# 通过终端环境或 GitHub Secrets 注入。程序读取进程环境。
NEUQ_USERNAME=
NEUQ_PASSWORD=
NEUQ_USE_WEBVPN=false
NEUQ_WEBVPN_EAMS_URL=
NEUQ_BUILDINGS=工学馆,科技楼,人文楼
NEUQ_DAYS=7
NEUQ_REQUEST_DELAY=2s
NEUQ_REQUEST_TIMEOUT=20s
NEUQ_TASK_TIMEOUT=12m
NEUQ_MAX_REQUESTS=200
NEUQ_MAX_PAGES=4
NEUQ_RETRIES=2
NEUQ_TODAY_TTL=2h
NEUQ_FUTURE_TTL=26h

# 这些变量由部署工作流使用。
NEUQ_COLLECTION_ENABLED=false
NEUQ_PUBLIC_ORIGIN=
CLOUDFLARE_PROJECT=neuq-one-data
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
